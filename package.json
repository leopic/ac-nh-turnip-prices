{
  "name": "ac-nh-turnip-prices",
  "version": "2.0.0",
  "description": "Turnip price predictor for Animal Crossing: New Horizons",
  "main": "service-worker.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "npx serve .",
    "prepare": "git config core.hooksPath .githooks",
    "generate-icons": "node scripts/generate-maskable-icon.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leopic/ac-nh-turnip-prices.git"
  },
  "keywords": [
    "animal-crossing",
    "turnip-prices",
    "predictor"
  ],
  "author": "Mike Bryant, leopic",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/leopic/ac-nh-turnip-prices/issues"
  },
  "homepage": "https://github.com/leopic/ac-nh-turnip-prices#readme",
  "overrides": {
    "undici": "^7.29.0",
    "vite": "^8.0.16",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "fast-uri": "^4.1.2",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "vitest": "^4.1.10"
  }
